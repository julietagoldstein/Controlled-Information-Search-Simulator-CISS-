<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI Chat</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#212121;
    height:100vh;
    display:flex;
}

#sidebar{
    width:260px;
    background:#171717;
    border-right:1px solid #333;
}

#main{
    flex:1;
    display:flex;
    flex-direction:column;
}

#messages{
    flex:1;
    overflow-y:auto;
    padding:40px;
}

#welcome{

    max-width:700px;
    margin:auto;
    text-align:center;
    color:white;

}

#welcome h1{

    font-size:34px;
    margin-bottom:15px;

}

#welcome p{

    color:#b5b5b5;
    line-height:1.5;

}

#inputArea{

    padding:20px;
    border-top:1px solid #333;
    background:#212121;

}

#inputContainer{

    max-width:900px;
    margin:auto;

}

#prompt{

    width:100%;
    background:#2f2f2f;
    color:white;

    border:none;
    outline:none;

    padding:18px;

    border-radius:18px;

    font-size:16px;

}

</style>

</head>

<body>

<div id="sidebar">

</div>

<div id="main">

<div id="messages">

<div id="welcome">

<h1>¿En qué puedo ayudarte?</h1>

<p>
Escribí una pregunta para comenzar.
</p>

</div>

</div>

<div id="inputArea">

<div id="inputContainer">

<input
id="prompt"
placeholder="Preguntá lo que quieras">

</div>

</div>

</div>

</body>
</html>
